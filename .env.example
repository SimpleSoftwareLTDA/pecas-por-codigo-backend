# Environment Variables (Local Template)
# Copy this file to .env for local development.

# --- App Configuration ---
SPRING_PROFILES_ACTIVE=local
CURRENT_URL=http://localhost:8080
SITE_URL=http://localhost:8080

# --- Database (Postgres) ---
# For local development with docker-compose.local.yml
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha
POSTGRES_DB=meubanco
DB_HOST=jdbc:postgresql://localhost:5432/meubanco

# --- Cache & Discovery ---
# Use the password defined in docker-compose.local.yml
REDIS_PASSWORD=Backtalk1-Anyplace5-Magnolia8-Refute6-Coke7

# --- Monitoring & Observability ---
# OTLP HTTP/gRPC local endpoints
OTEL_ENDPOINT_METRICS=http://localhost:4318/v1/metrics
OTEL_ENDPOINT_TRACES=http://localhost:4318/v1/traces
OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# --- API Keys & Credentials (Placeholders for Local) ---
# Replace with real keys if testing integrations.
ASAAS_API_KEY=YOUR_SANDBOX_KEY_HERE
SENTRY_AUTH_TOKEN=YOUR_SENTRY_TOKEN_HERE

# Proxy/Internal Services
DECODO_USER=local_user
DECODO_PASS=local_pass

# Email (Disabled by default in application-local.yml)
MAIL_USERNAME=placeholder@gmail.com
MAIL_PASSWORD=placeholder_app_password